GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/

# Fallback Search API (Optional but recommended if DuckDuckGo gets rate-limited)
# Get a free key at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

FIRECRAWL_API_KEY=your_firecrawl_api_key_here
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ig_project
GROQ_API_KEY=your_groq_api_key_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Zulip Bot Credentials (Optional - Falls back to ~/.zuliprc)
# Pattern: ZULIP_<IG_NAME_UPPER>_EMAIL / ZULIP_<IG_NAME_UPPER>_KEY
ZULIP_AI_EMAIL=your_ai_bot_email
ZULIP_AI_KEY=your_ai_bot_key
ZULIP_CYBER_SECURITY_EMAIL=your_cs_bot_email
ZULIP_CYBER_SECURITY_KEY=your_cs_bot_key
ZULIP_WEB_DEVELOPMENT_EMAIL=your_wd_bot_email
ZULIP_WEB_DEVELOPMENT_KEY=your_wd_bot_key
